---
import '../styles/site.css';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/manrope';
import '@fontsource-variable/noto-serif-malayalam';
import fraunces from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import Enquiry from '../components/Enquiry.astro';
import LocationMap from '../components/LocationMap.astro';
import {site, whatsapp} from '../site.config';
const { title = 'Kerala, at its own pace', description = 'Private Kerala journeys from Kochi, across tea country, the coast and the backwaters.', campaign = false, image='/images/hero-1280.webp', schema=[], noIndex=false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageChat = whatsapp(`Hi, I'm checking ${title} on your website.`);
const menus = [['Kerala', ['Adventure','Ayurveda','Backwater','Beach','Cultural','Hill Station','Honeymoon','Pilgrimage','Wildlife','Family']],['Domestic',['Goa','Hyderabad','North India','Andaman']],['International',['Malaysia','Dubai','Thailand','Singapore']]];
---
<!doctype html><html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
{noIndex && <meta name="robots" content="noindex"/>}
<title>{title} | {site.name}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={`${title} | ${site.name}`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image, Astro.site)}/>
<link rel="icon" type="image/svg+xml" href="/mark.svg"/><link rel="preload" as="font" type="font/woff2" href={fraunces} crossorigin/><link rel="preload" as="font" type="font/woff2" href={manrope} crossorigin/>
<script type="application/ld+json" set:html={JSON.stringify([{"@context":"https://schema.org","@type":"TravelAgency",name:site.name,url:Astro.site?.href,areaServed:"Kerala", ...(site.phone && { telephone:site.phone }), ...(site.email && {email:site.email})},...schema]).replace(/</g,'\\u003c')}/>
</head>
<body>
<a class="skip" href="#main">Skip to content</a><div class="route-curtain" aria-hidden="true"></div>
{!campaign && <header class="site-header">
  <div class="utility"><div class="shell"><span><Icon name="pin" size={14}/> Kochi, Kerala · India</span><div>{site.hours && <span>{site.hours}</span>}{site.phone && <a href={`tel:${site.phone}`}>{site.phone}</a>}{site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}{pageChat && <a href={pageChat}>WhatsApp</a>}{site.socials.map(s=><a href={s.url}>{s.label}</a>)}{!site.phone && <a href="/contact/">Trip planning & enquiries <Icon name="diagonal" size={13}/></a>}</div></div></div>
  <div class="shell nav"><Logo/><button type="button" class="menu-toggle icon-button" aria-controls="main-nav" aria-expanded="false" aria-label="Open menu"><Icon name="menu"/></button>
  <nav id="main-nav" aria-label="Main navigation">
    <details class="mega"><summary>Tour Packages <Icon name="down" size={14}/></summary><div class="mega-panel">{menus.map(([area, entries])=><section><h2><a href={`/packages/?region=${area}`}>{area}</a></h2>{(entries as string[]).map(entry=><a href={`/packages/?${area==='Kerala' ? 'theme' : 'destination'}=${encodeURIComponent(entry)}`}>{entry}</a>)}</section>)}<a class="text-link" href="/packages/">All itineraries <Icon name="arrow" size={16}/></a></div></details>
    <a href="/destinations/">Destinations</a><a href="/taxi/">Taxi Rentals</a><a href="/houseboats/">Houseboats</a><a href="/kerala/">Kerala Guide</a><a href="/about/">About</a><a href="/blog/">Blog</a><a href="/contact/">Contact</a>
  </nav><button class="button nav-cta" data-enquire>Plan my trip <Icon name="diagonal" size={15}/></button></div>
</header>}
<main id="main"><slot/></main>
{!campaign && <footer class="footer"><div class="shell footer-grid">
<div><Logo/><p>Private journeys through tea country, quiet waterways and the Kerala coast.</p><a href="/credits/">Photography credits</a></div>
<div><h2>Explore</h2><a href="/packages/">Tour packages</a><a href="/destinations/">Destinations</a><a href="/taxi/">Taxi rentals</a><a href="/houseboats/">Houseboats</a><a href="/kerala/">Kerala guide</a><a href="/kerala/#seasons">Best time to visit</a><a href="/kerala/#festivals">Festival calendar</a></div>
<div><h2>Kasavu Journeys</h2><a href="/about/">About us</a><a href="/services/">Services</a><a href="/testimonials/">Trip feedback</a><a href="/blog/">Travel journal</a><a href="/contact/">Contact</a></div>
<div><h2>Find us</h2><p>{site.address || 'Kochi, near Cochin International Airport'}{site.hours && <><br/>{site.hours}</>}</p>{site.phone && <a href={`tel:${site.phone}`}>{site.phone}</a>}{site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}{site.socials.map(s=><a href={s.url}>{s.label}</a>)}<a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`} target="_blank" rel="noopener">{site.address ? 'Office on the map' : 'Cochin Airport on the map'} <Icon name="diagonal" size={14}/></a><LocationMap compact/>
{site.newsletter ? <form action={site.newsletter} method="post"><label for="newsletter">Travel notes by email</label><input id="newsletter" type="email" name="email" required autocomplete="email"/><button class="button">Subscribe</button></form> : <a href="/blog/">Read our travel notes</a>}</div></div>
<div class="shell footnote"><span>© {new Date().getFullYear()} {site.name}</span><span lang="ml">കേരളം</span></div></footer>}
<Enquiry/>
{!campaign && <div class:list={['contact-dock',site.phone && pageChat && 'has-mobile-contact']}>
{site.phone && <a class="icon-button" href={`tel:${site.phone}`} aria-label="Call"><Icon name="phone"/><span>Call</span></a>}{site.email && <a class="icon-button" href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail"/><span>Email</span></a>}{pageChat && <a class="icon-button dock-primary dock-chat" href={pageChat} aria-label="WhatsApp"><Icon name="chat"/><span>WhatsApp</span></a>}<button class:list={['icon-button dock-enquiry',!pageChat && 'dock-primary']} data-enquire aria-label="Open trip enquiry"><Icon name="chat"/><span>Enquire</span></button>
</div>}
<script>import '../scripts/global';</script>
</body></html>
