---
import Icon from './Icon.astro';
import destinations from '../data/destinations.json';
const themes = ['Adventure','Ayurveda','Backwater','Beach','Cultural','Family','Hill Station','Honeymoon','Pilgrimage','Wildlife'];
const fields = [
  ['pin','Destination','destination','Anywhere in Kerala', destinations.map(x=>[x.slug,x.name])],
  ['compass','Travel style','theme','Any experience',themes.map(x=>[x,x])],
  ['time','Duration','duration','Any length',[['1-3','1–3 days'],['4-6','4–6 days'],['7-30','7+ days']]],
  ['users','Travellers','travellers','Any group',[['1','Solo'],['2','2 travellers'],['3-5','3–5 travellers'],['6+','6+ travellers']]],
  ['calendar','Travel month','month','Any month',Array.from({length:12},(_,i)=>[String(i+1),new Intl.DateTimeFormat('en',{month:'long'}).format(new Date(2026,i,7))])],
] as const;
---
<form class="trip-search" action="/packages/" method="get" id="trip-search" aria-label="Find your Kerala trip">
{fields.map(([icon,label,name,placeholder,options])=><label class="search-field"><Icon name={icon} size={20}/><span>{label}<select name={name}><option value="">{placeholder}</option>{options.map(([value,text])=><option value={value}>{text}</option>)}</select></span></label>)}
<button class="button" type="submit"><Icon name="search" size={18}/> Find my trip</button>
</form>
