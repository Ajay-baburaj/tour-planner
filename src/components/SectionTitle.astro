---
import Icon from './Icon.astro';
const {eyebrow,title,accent,link,label}=Astro.props;
---
<div class="section-heading"><div><p class="eyebrow gold-rule">{eyebrow}</p><h2>{title}{accent && <> <em>{accent}</em></>}</h2></div>{link && <a class="text-link" href={link}>{label} <Icon name="diagonal" size={16}/></a>}</div>
