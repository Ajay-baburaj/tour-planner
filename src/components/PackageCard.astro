---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import {currency, site, whatsapp} from '../site.config';
const { trip, interactive=false, compact=false } = Astro.props;
const contact = whatsapp(`Hi, I'm interested in ${trip.title} (${trip.days-1}N/${trip.days}D). Travel date: __ Guests: __`);
---
<article class="package-card" data-package={trip.slug} data-price={trip.price} data-days={trip.days} data-theme={trip.theme} data-region={trip.region} data-destinations={trip.route.join('|')} data-months={trip.months.join('|')} data-max-guests={trip.maxGuests} data-popularity={trip.popularity}>
<div class="card-photo">
 <a href={`/packages/${trip.slug}/`} aria-label={trip.title}><Photo image={trip.images[0]} position="center 63%" sizes="(max-width: 650px) 95vw, 34vw"/>{!compact && trip.images.slice(1).map((name:string)=><Photo image={name} class="slide-photo" sizes="(max-width: 650px) 95vw, 34vw"/>)}</a>
 {trip.badge && <span class="card-badge">{trip.badge}</span>}
 {interactive && <button type="button" class="icon-button save-trip" data-save={trip.slug} aria-label={`Save ${trip.title}`} aria-pressed="false"><Icon name="heart" size={18}/></button>}
 {!compact && trip.images.length>1 && <button type="button" class="icon-button photo-next" data-card-next aria-label={`Next photo of ${trip.title}`}><Icon name="arrow" size={16}/></button>}
</div>
<div class="package-body"><p class="eyebrow package-meta">{trip.theme} <span></span> {trip.days-1} nights / {trip.days} days</p><h3><a href={`/packages/${trip.slug}/`}>{trip.title}</a></h3><p class="package-places"><Icon name="pin" size={16}/>{trip.places.join(' · ')}</p>
{!compact && <ul class="highlights">{trip.highlights.map((text:string)=><li>{text}</li>)}</ul>}
<div class="package-actions"><p>From <b>{currency(trip.price)}</b><small> per person</small></p><a class="icon-button" href={`/packages/${trip.slug}/`} aria-label={`View details for ${trip.title}`}><Icon name="diagonal" size={19}/></a></div>
{!compact && <div class="package-tools"><a href={`/packages/${trip.slug}/`}>View details</a>{contact && <a href={contact}>WhatsApp</a>}{site.phone && <a href={`tel:${site.phone}`}>Call</a>}{site.email && <a href={`mailto:${site.email}?subject=${encodeURIComponent(trip.title)}&body=${encodeURIComponent('I would like to enquire about '+trip.title+'.')}`}>Email</a>}{interactive && <><button type="button" data-quick={trip.slug}>Quick view</button><label><input type="checkbox" data-compare={trip.slug}/> Compare</label></>}</div>}
</div></article>
