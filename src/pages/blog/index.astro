---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageLead from '../../components/PageLead.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import {breadcrumbSchema} from '../../data/catalogue';
const articles=(await getCollection('blog')).sort((a,b)=>a.data.order-b.data.order);
const categories=[...new Set(articles.map(article=>article.data.category))].sort();
---
<Base title="Kerala travel journal" description="Practical notes on Kerala’s tea estates, backwaters, wildlife, coast and historic towns." schema={[breadcrumbSchema(Astro.site,[{name:'Travel journal',path:'/blog/'}])]}>
<PageLead eyebrow="Field notes from Kerala" title="The travel journal." summary="Find practical details for planning days on the backwaters, in the high ranges and near the sea." crumbs={[{label:'Travel journal'}]}/>
<section class="shell section catalogue">
<div class="filters panel"><label>Search articles<input type="search" data-journal-query placeholder="Search places and topics"/></label><label>Category<select data-journal-category><option value="">All categories</option>{categories.map(tag=><option>{tag}</option>)}</select></label></div>
<p class="list-caption" data-journal-count role="status">{articles.length} articles</p>
<p class="status-empty" data-journal-empty hidden>No articles match. Try another search or category.</p>
<div class="journal-grid journal-list">{articles.map(({id,data})=><article data-journal={data.category}><a href={`/blog/${id}/`}><Photo image={data.photo} alt={data.alt}/><p class="eyebrow">{data.category} · {data.minutes} min read</p><h3>{data.title} <Icon name="diagonal" size={16}/></h3><p class="journal-summary">{data.summary}</p></a></article>)}</div>
</section>
<script>
const articles=Array.from(document.querySelectorAll<HTMLElement>('[data-journal]'));
const input=document.querySelector<HTMLInputElement>('[data-journal-query]')!;
const category=document.querySelector<HTMLSelectElement>('[data-journal-category]')!;
const count=document.querySelector<HTMLElement>('[data-journal-count]')!;
const empty=document.querySelector<HTMLElement>('[data-journal-empty]')!;
function filter(){
  const term=input.value.trim().toLocaleLowerCase();
  let shown=0;
  for(const article of articles){
    article.hidden=Boolean((term && !article.textContent?.toLocaleLowerCase().includes(term)) || (category.value && category.value!==article.dataset.journal));
    shown+=Number(!article.hidden);
  }
  count.textContent=`${shown} ${shown===1?'article':'articles'}`;
  empty.hidden=shown!==0;
}
input.addEventListener('input',filter);
category.addEventListener('change',filter);
</script>
</Base>
