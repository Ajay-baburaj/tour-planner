---
import {getCollection,render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import {places,breadcrumbSchema} from '../../data/catalogue';
export async function getStaticPaths(){return (await getCollection('blog')).map(article=>({params:{slug:article.id},props:{article}}));}
const {article}=Astro.props;
const {data}=article;
const {Content}=await render(article);
const place=places.find(place=>place.slug===data.destination)!;
const image=`/images/${data.photo}-960.webp`;
---
<Base title={data.title} description={data.summary} image={image} schema={[breadcrumbSchema(Astro.site,[{name:'Travel journal',path:'/blog/'},{name:data.title,path:Astro.url.pathname}]),{"@context":"https://schema.org","@type":"Article",headline:data.title,description:data.summary,image:new URL(image,Astro.site).href}]}>
<div class="article-progress" aria-hidden="true"></div>
<section class="detail-hero"><Photo image={data.photo} alt={data.alt} eager sizes="100vw" position="center 64%"/><div class="shell"><Crumbs items={[{label:'Travel journal',url:'/blog/'},{label:data.title}]}/><p class="eyebrow gold-rule">{data.category} · {data.minutes} min read</p><h1>{data.title}</h1><p>{data.summary}</p></div></section>
<article class="article-wrap section article-copy" data-reading><Content/><p><a class="text-link" href={`/destinations/${place.slug}/`}>Explore {place.name} <Icon name="diagonal" size={16}/></a></p></article>
<script>
const bar=document.querySelector<HTMLElement>('.article-progress');
const article=document.querySelector<HTMLElement>('[data-reading]');
let frame=0;
const update=()=>{
  if(!article || !bar) return;
  const box=article.getBoundingClientRect();
  const progress=Math.max(0,Math.min(1,(-box.top+innerHeight*.25)/Math.max(1,box.height-innerHeight*.55)));
  bar.style.transform=`scaleX(${progress})`;frame=0;
};
addEventListener('scroll',()=>{if(!frame) frame=requestAnimationFrame(update);},{passive:true});
update();
</script>
</Base>
