---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import Crumbs from '../../components/Crumbs.astro';
import PackageCard from '../../components/PackageCard.astro';
import Form from '../../components/Form.astro';
import Review from '../../components/Review.astro';
import reviews from '../../data/reviews.json';
import SectionTitle from '../../components/SectionTitle.astro';
import {trips,places,tiers,priceFor,packageFaqs,routeMap,breadcrumbSchema} from '../../data/catalogue';
import {currency, site, whatsapp} from '../../site.config';
export function getStaticPaths(){return trips.map(trip=>({params:{slug:trip.slug},props:{trip}}));}
const {trip}=Astro.props;
const matchingReviews=reviews.filter(item=>item.trip===trip.slug);
const related=trips.filter(candidate=>candidate.slug!==trip.slug && (candidate.route.some(point=>trip.route.includes(point)) || candidate.theme===trip.theme)).slice(0,3);
const contact=whatsapp(`Hi, I'm interested in ${trip.title} (${trip.days-1}N/${trip.days}D). Travel date: __ Guests: __`);
const context=`${trip.title} (${trip.days-1}N/${trip.days}D)`;
const image=`/images/${trip.images[0]}-960.webp`;
const schema=[breadcrumbSchema(Astro.site,[{name:'Tour packages',path:'/packages/'},{name:trip.title,path:Astro.url.pathname}]),
 {"@context":"https://schema.org","@type":"TouristTrip",name:trip.title,description:trip.summary,touristType:trip.theme,itinerary:{"@type":"ItemList",itemListElement:trip.places.map((name,i)=>({"@type":"ListItem",position:i+1,item:{"@type":"Place",name}}))}},
 {"@context":"https://schema.org","@type":"Product",name:trip.title,description:trip.summary,image:new URL(image,Astro.site).href,offers:{"@type":"Offer",priceCurrency:"INR",price:trip.price,url:new URL(Astro.url.pathname,Astro.site).href}},
 {"@context":"https://schema.org","@type":"FAQPage",mainEntity:packageFaqs.map(entry=>({"@type":"Question",name:entry.title,acceptedAnswer:{"@type":"Answer",text:entry.text}}))}];
---
<Base title={trip.title} description={trip.summary} image={image} schema={schema}>
<section class="detail-hero"><Photo image={trip.images[0]} alt={`Landscape from the ${trip.title} itinerary`} sizes="100vw" eager position="center 64%"/><div class="shell">
<Crumbs items={[{label:'Tour packages',url:'/packages/'},{label:trip.title}]}/><p class="eyebrow gold-rule">{trip.theme} · {trip.days-1} nights / {trip.days} days</p><h1>{trip.title}</h1><p>{trip.places.join(' · ')}</p></div>
</section>
<section class="shell section detail-layout">
<article class="article-copy">
  <h2>Overview</h2><p>{trip.summary}</p><ul>{trip.highlights.map(text=><li>{text}</li>)}</ul>
  <div class="gallery-row" aria-label="Itinerary photographs">{trip.images.map((pic,index)=><button type="button" data-lightbox-src={`/images/${pic}-960.webp`} data-lightbox-alt={`${trip.title} · photo ${index+1}`} aria-label={`Enlarge itinerary photo ${index+1}`}><Photo image={pic}/></button>)}</div>
  <dialog class="lightbox" data-lightbox aria-label="Itinerary gallery"><button type="button" class="icon-button dialog-close" data-lightbox-close aria-label="Close photo gallery"><Icon name="close"/></button><figure><img alt="" width="960" height="540"/><figcaption></figcaption></figure><div class="lightbox-controls"><button class="button outline" data-lightbox-step="-1">Previous photo</button><button class="button outline" data-lightbox-step="1">Next photo</button></div></dialog>
  <h2>Day by day</h2><ol class="timeline">{trip.itinerary.map((day,index)=>
    <li><details class="accordion" open={index===0}><summary>Day {index+1} · {day.title}</summary><p>{day.text}</p></details></li>)}</ol>
  <a class="text-link" href={`/packages/itinerary/${trip.slug}/`}>Print or save itinerary as PDF <Icon name="diagonal" size={16}/></a>
  <h2>Route</h2>
  <div class="itinerary-map" role="img" aria-label={`Schematic route through ${trip.places.join(', ')}`}>
  <svg viewBox="0 0 650 152" aria-hidden="true" preserveAspectRatio="none"><path d={`M42 75${trip.places.slice(1).map((_:string,i:number)=>` Q${42+(i+.55)*(566/Math.max(1,trip.places.length-1))} ${i%2===0?118:32} ${42+(i+1)*(566/Math.max(1,trip.places.length-1))} 75`).join('')}`} stroke="#99a18c" stroke-width="2" fill="none" stroke-dasharray="3 5"/>{trip.places.map((_:string,i:number)=><g><circle cx={42+i*(566/Math.max(1,trip.places.length-1))} cy="75" r="15" fill="#0e3b34"/><text x={42+i*(566/Math.max(1,trip.places.length-1))} y="80" text-anchor="middle" fill="#f4efe3">{i+1}</text></g>)}</svg>
  </div><ol class="route-stops">{trip.places.map((name,index)=>{
    const place=places.find(d=>d.slug===trip.route[index]);
    return <li>{place ? <a href={`/destinations/${place.slug}/`}>{name}</a> : name}</li>;
  })}</ol>
  <a class="text-link" href={routeMap(trip)} target="_blank" rel="noopener">Open route in Google Maps <Icon name="diagonal" size={16}/></a>
  <h2>Inclusions & exclusions</h2>
  <div class="content-cards"><article><h3>Included</h3><ul><li>Accommodation at the selected tier</li><li>Private transfers listed in the itinerary</li><li>Breakfast at participating stays</li>{trip.route.includes('alleppey') && <li>Houseboat meals during an overnight cruise, when quoted</li>}</ul></article><article><h3>Separate costs</h3><ul><li>Flights, entry tickets and optional activities</li><li>Meals outside the quoted plan</li><li>Insurance and personal expenses</li></ul></article></div>
  <h2>Hotel options & meal plan</h2>{tiers.map(tier=><p><strong>{tier.name}</strong> · {tier.notes}</p>)}<p>Breakfast is the standard hotel meal plan. Overnight houseboat quotes specify lunch, evening tea, dinner and breakfast on board.</p>
  <h2>Frequently asked questions</h2>{packageFaqs.map(entry=><details class="accordion"><summary>{entry.title}</summary><p>{entry.text}</p></details>)}
  <h2>Cancellation policy</h2><p>Review the booking-specific terms before paying a deposit. The quote states the cancellation dates, any supplier charges and how refunds are handled.</p>
  <h2>Trip feedback</h2>{matchingReviews.map(review=><Review review={review}/>)}<p><a href="/testimonials/">Read sample traveller notes</a> for suggestions about early starts, road days and houseboat boarding.</p>
</article>
<aside class="panel sticky-panel" id="enquiry">
  <p class="eyebrow">Indicative starting price</p><h2><output data-tier-price>{currency(trip.price)}</output> <small>per person</small></h2>
  <p>Twin sharing · {trip.days} days. Request a quote for your dates.</p>
  <div class="chips tiers" role="group" aria-label="Hotel tier">{tiers.map((tier,i)=><button type="button" data-tier={tier.name} data-price={priceFor(trip.price,i)} aria-pressed={String(i===0)}>{tier.name}</button>)}</div>
  <div class="detail-contact">{contact && <a class="text-link" href={contact}>WhatsApp <Icon name="chat" size={15}/></a>}{site.phone && <a class="text-link" href={`tel:${site.phone}`}>Call <Icon name="phone" size={15}/></a>}</div>
  <Form id="package" context={context} kind="package" choices={tiers.map(t=>t.name)} defaultChoice="Standard"/>
</aside>
</section>
{related.length>0 && <section class="shell section related"><SectionTitle eyebrow="More private tours" title="Other ways to go." link="/packages/" label="View all itineraries"/><div class="package-grid">{related.map(item=><PackageCard trip={item} compact/>)}</div></section>}
<script>import '../../scripts/detail';</script>
</Base>
