---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import TripSearch from '../components/TripSearch.astro';
import SectionTitle from '../components/SectionTitle.astro';
import DestinationCard from '../components/DestinationCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Journey from '../components/Journey.astro';
import Hills from '../components/Hills.astro';
import KeralaMap from '../components/KeralaMap.astro';
import Climate from '../components/Climate.astro';
import HeroFilm from '../components/HeroFilm.astro';
import destinations from '../data/destinations.json';
import packages from '../data/packages.json';
import reviews from '../data/reviews.json';
import Review from '../components/Review.astro';
import {site} from '../site.config';
const cards = ['munnar','alleppey','varkala'].map(slug=>destinations.find(place=>place.slug===slug)!);
const themes = ['Honeymoon','Family','Backwater','Beach','Ayurveda','Adventure','Cultural','Pilgrimage','Wildlife','Hill Station'];
const experiences = [
  ['Snake boat races','Along the Punnamada course, crews pull the oars in time to the vanchipattu.','boat','/destinations/alleppey/'],
  ['Kathakali after dark','Arrive early to watch performers apply their elaborate make-up before the drums begin.','culture','/destinations/kochi/'],
  ['Theyyam in North Malabar','Find out what is scheduled at a local shrine, where ritual and performance meet.','theyyam','/destinations/bekal/'],
  ['Ayurveda on the coast','Leave room in the itinerary for a consultation with a qualified practitioner.','wellness','/packages/?theme=Ayurveda'],
  ['Pepper and cardamom','Walk a working spice garden around Kumily and learn what grows in the shade.','periyar','/destinations/thekkady/'],
  ['Fort Kochi’s fishing nets','Walk the waterfront while the crews lower their cantilevered nets.','kochi','/destinations/kochi/'],
];
const articles = [
 ['tea','A morning in Munnar’s tea country','/blog/munnar-tea-country/'],
 ['water','Houseboat or canoe? A backwater guide','/blog/houseboat-or-canoe/'],
 ['kochi','Fort Kochi on foot','/blog/fort-kochi-on-foot/'],
];
const offerEnd = '2027-03-31T23:59:59+05:30';
---
<Base>
  <div class="prelude" aria-hidden="true"><svg viewBox="0 0 80 80"><path pathLength="1" d="M0 65H64M37 64c6-14 10-29 7-43m0 0c-16-13-29-7-34 9 11-8 25-11 34-9Zm0 0c-2-12 7-17 17-13-10 1-14 7-17 13Zm0 0c14-7 25 0 25 13-7-7-14-12-25-13Zm0 0c-12 1-21 12-21 24 5-11 12-18 21-24Z"/></svg><span>Kasavu Journeys</span></div>
  <section class="hero" aria-labelledby="hero-title">
    <HeroFilm/>
    <div class="hero-shade"></div>
    <div class="shell hero-content">
      <p class="eyebrow gold-rule hero-label">Private journeys across Kerala</p>
      <h1 id="hero-title"><span class="line-mask"><span>Kerala,</span></span><span class="line-mask"><span><em>at its own pace.</em></span></span></h1>
      <p class="hero-summary">Tea country at first light. A night on the backwaters. Private journeys from Kochi, built around the way you like to travel.</p>
      <div class="hero-actions"><a class="button gold magnetic" href="#trip-search">Find your Kerala trip <Icon name="diagonal" size={17}/></a><a class="hero-link" href="/destinations/">Explore destinations <Icon name="arrow" size={17}/></a></div>
    </div>
    <div class="shell hero-foot"><span class="hero-ml" lang="ml" aria-hidden="true">കേരളം</span><span class="photo-caption static-caption"><Icon name="pin" size={16}/> Alleppey Backwaters <span>09°30′ N · 76°20′ E</span></span><HeroFilm area="controls"/></div>
  </section>
  <div class="shell search-wrap"><TripSearch/></div>
  <section class="shell section home-destinations" id="destinations">
    <SectionTitle eyebrow="Where to go" title="Many roads," accent="one Kerala." link="/destinations/" label="View all destinations"/>
    <div class="destination-feature">{cards.map(place=><DestinationCard place={place}/>)}</div>
  </section>
  <div class="kerala-marquee" aria-label="Kerala destinations"><button type="button" class="marquee-toggle" data-marquee-toggle aria-controls="destination-marquee" hidden>Pause names</button><div id="destination-marquee">{[0,1].map((_,copy)=><span aria-hidden={copy===1 ? 'true' : undefined}>{[destinations[0],destinations[1],destinations[4],destinations[6],destinations[2]].map(p=><><span lang="ml">{p.malayalam}</span><span>{p.name}</span><b>✦</b></>)}</span>)}</div></div>
  <section class="shell section home-packages">
    <SectionTitle eyebrow="Kerala tour packages" title="Journeys worth" accent="taking slowly." link="/packages/" label="Browse all packages"/>
    <div class="package-grid">{packages.slice(0,3).map(trip=><PackageCard trip={trip} compact/>)}</div>
    <div class="themes"><h3>Find your kind of trip</h3><div class="chips">{themes.map(theme=><a href={`/packages/?theme=${encodeURIComponent(theme)}`}>{theme}</a>)}</div></div>
  </section>
  <Journey/>
  <section class="taxi-strip"><div class="shell taxi-strip-inner"><div class="taxi-art"><Icon name="car" size={68}/><span></span></div><div><p class="eyebrow gold-rule">Airport pickups & private drivers</p><h2>Kerala, by road.</h2><p>From a Cochin Airport pickup to a week in the hills, choose a vehicle with room for your group and bags.</p></div><a class="button" href="/taxi/">Explore taxi rentals <Icon name="diagonal" size={16}/></a></div></section>
  <Hills/>
  <section class="experience-section section"><div class="shell"><SectionTitle eyebrow="Beyond the itinerary" title="Make time for" accent="the details."/></div><div class="experience-viewport" tabindex="0" aria-label="Scroll to explore experiences"><div class="experience-rail">{experiences.map(([name,copy,img,url])=><article><a href={url}><Photo image={img} sizes="(max-width: 600px) 72vw, 360px" position={img==='boat'?'center 68%':'center'}/><div><h3>{name}</h3><p>{copy}</p></div></a></article>)}</div></div></section>
  <Climate/>
  <section class="shell section map-section"><SectionTitle eyebrow="Kerala, north to south" title="Follow the coast." accent="Then turn inland."/><KeralaMap/></section>
  <section class="why"><div class="shell"><div><p class="eyebrow gold-rule">How we plan</p><h2>Built around <em>your days.</em></h2></div><div><p>Start with where you want to wake up. We’ll lay out the driving days, match the rooms to your group and leave space for weather, tides and long lunches.</p><div class="counts"><div><strong data-count={site.trust.years || destinations.length}>{site.trust.years || destinations.length}</strong><span>{site.trust.years ? 'Years in business' : 'Kerala destinations'}</span></div><div><strong data-count={site.trust.travellers || packages.length}>{site.trust.travellers || packages.length}</strong><span>{site.trust.travellers ? 'Travellers served' : 'Sample itineraries'}</span></div><div><strong data-count="3">3</strong><span>Hotel tiers</span></div></div></div></div></section>
  <section class="shell section quote-section"><SectionTitle eyebrow="Notes from the route" title="What travellers" accent="notice." link="/testimonials/" label="Read trip feedback"/><div class="quote-track" tabindex="0" aria-label="Sample traveller stories">{reviews.map(review=><Review review={review}/>)}</div><div class="carousel-controls"><button class="icon-button" data-quote="-1" aria-label="Previous traveller story">‹</button><button class="icon-button" data-quote="1" aria-label="Next traveller story">›</button></div></section>
  <section class="offer-strip"><div class="shell"><div><p class="eyebrow gold-rule">Seasonal planning · through 31 March 2027</p><h2>Tea Hills & Backwaters</h2><p>Five days from ₹18,900 per person. Indicative twin-share price.</p></div><div class="offer-count" data-countdown={offerEnd} aria-label="Time left in this planning window"></div><a class="button gold" href="/packages/tea-and-tides/">See the itinerary <Icon name="diagonal" size={17}/></a></div></section>
  <section class="shell section home-journal"><SectionTitle eyebrow="The travel journal" title="Good to know" accent="before you go." link="/blog/" label="Read the journal"/><div class="journal-grid">{articles.map(([pic,title,url])=><a href={url}><Photo image={pic}/><h3>{title} <Icon name="diagonal" size={16}/></h3></a>)}</div></section>
  <section class="gallery-grid" aria-label="Kerala in photographs">{['tea','boat','theyyam','falls','beach'].map((pic,i)=><a href={`/destinations/${['munnar','alleppey','bekal','athirappilly','varkala'][i]}/`} aria-label={['Munnar tea country','Alleppey backwaters','North Malabar Theyyam','Athirappilly Falls','Varkala coast'][i]}><Photo image={pic} sizes="(max-width: 620px) 50vw, 20vw" position={pic==='boat'?'center 70%':'center'}/></a>)}</section>
  <section class="final-cta"><div class="shell"><p lang="ml" aria-hidden="true">സ്വാഗതം</p><h2>Where in Kerala<br/> would you wake up?</h2><p>Tell us who’s travelling, when you’re free and how you like to spend a day.</p><button class="button gold" type="button" data-enquire>Plan my trip <Icon name="diagonal" size={16}/></button></div></section>
  <script>import '../scripts/home';</script>
</Base>
